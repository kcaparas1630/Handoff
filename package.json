{
  "name": "handoff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "maestro test tests/e2e",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:parents": "pnpm --filter @handoff/parents start",
    "dev:daycare": "pnpm --filter @handoff/daycare start",
    "dev:api": "pnpm --filter @handoff/api dev",
    "dev:worker": "pnpm --filter @handoff/worker start",
    "eval:extraction": "tsx scripts/evaluate-extraction.ts",
    "storage:provision": "tsx scripts/provision-storage.ts",
    "verify:purge": "tsx scripts/verify-purge.ts",
    "verify:restore": "tsx scripts/verify-encrypted-restore.ts",
    "seed:pilot": "tsx scripts/seed-pilot.ts",
    "measure:pilot": "tsx scripts/measure-pilot.ts",
    "build:api": "pnpm --filter @handoff/api export"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "tsx": "^4.23.13"
  }
}
