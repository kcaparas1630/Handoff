# Public mobile configuration: bundled into the app, never a secret.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=

# Server/worker-only configuration: never referenced from a mobile bundle.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_GUARDIAN_ROLE_KEY=
# Optional comma-separated list of allowed token azp values (app origins); omit for Clerk defaults.
CLERK_AUTHORIZED_PARTIES=
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_JOB_DISPATCH_URL=
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
DEEPGRAM_API_KEY=
TRANSCRIPTION_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
# Worker sizing. Milestone 3 starts at two concurrent jobs with a two-minute lease.
WORKER_CONCURRENCY=
WORKER_LEASE_SECONDS=
INVITATION_REDIRECT_URL=
APP_LINK_PARENTS=
APP_LINK_DAYCARE=

# Observability. The snapshot interval for the JSON metrics line, and the shared token that makes
# GET /v1/internal/metrics exist at all; leave it blank and the endpoint answers 404.
METRICS_FLUSH_SECONDS=
INTERNAL_METRICS_TOKEN=

# Quotas and spend caps, per UTC day. Blank uses the documented defaults: 200 captures per user,
# 3600 audio seconds per workspace, and US$5 of estimated extraction spend per workspace.
QUOTA_CAPTURES_PER_USER_PER_DAY=
QUOTA_AUDIO_SECONDS_PER_WORKSPACE_PER_DAY=
QUOTA_EXTRACTION_USD_PER_WORKSPACE_PER_DAY=

# How long a deleted workspace's scope keys stay decrypt-only before they may be retired. Default
# 30 days. Retiring a key a retained backup still needs is unrecoverable.
WORKSPACE_KEY_RETENTION_DAYS=

# PII key material: PII_KMS_KEY_ID is a key reference; the dev wrapping key is local/synthetic only.
PII_KEY_PROVIDER=
PII_KMS_KEY_ID=
AWS_REGION=
PII_DEV_WRAPPING_KEY_B64=
