{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@handoff/config/nativewind-preset": ["../../packages/config/nativewind-preset.ts"],
      "@handoff/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../../packages/config/nativewind-types.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
